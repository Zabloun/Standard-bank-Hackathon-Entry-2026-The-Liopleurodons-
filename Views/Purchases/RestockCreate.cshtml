@model PurchaseCreateViewModel
@{
    ViewData["Title"] = "Record Purchase";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Add Expense</div>
        <div class="page-sub">Record stock restock</div>
    </div>
    <a asp-controller="Business" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<form asp-controller="Purchases" asp-action="RestockCreate" method="post" class="form-section">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="ProductId" class="form-label">Product Purchased</label>
        <select asp-for="ProductId" class="form-select" id="product-select" onchange="updateEstimate()">
            <option value="">— Choose product —</option>
            @foreach (var p in Model.Products)
            {
                <option value="@p.ProductId" data-price="@p.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                    @p.DisplayName
                </option>
            }
        </select>
        <span asp-validation-for="ProductId" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Quantity" class="form-label">Quantity Bought</label>
        <input asp-for="Quantity" class="form-input" type="number" min="1" placeholder="e.g. 24"
               id="qty-input" oninput="updateEstimate()" />
        <span asp-validation-for="Quantity" class="form-error"></span>
    </div>

    <!-- Live cost estimate -->
    <div id="cost-preview" style="display:none;margin-bottom:16px">
        <div class="card" style="background:var(--red-bg);border-color:var(--red);padding:14px 16px">
            <div class="card-label" style="color:var(--red)">Estimated Cost</div>
            <div class="card-value red" id="cost-val">R0.00</div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Record Purchase</button>
    <div style="margin-top:10px">
        <a asp-controller="Business" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateEstimate() {
            const sel = document.getElementById('product-select');
            const qty = parseFloat(document.getElementById('qty-input').value) || 0;
            const price = parseFloat(sel.selectedOptions[0]?.dataset?.price || 0);
            const preview = document.getElementById('cost-preview');
            const val = document.getElementById('cost-val');
            if (price > 0 && qty > 0) {
                preview.style.display = 'block';
                val.textContent = 'R' + (price * qty).toFixed(2);
            } else {
                preview.style.display = 'none';
            }
        }
    </script>
}

@{
    ViewData["Title"] = "Personal";
    ViewData["ActiveNav"] = "personal";
}

<div class="page-header">
    <div>
        <div class="page-title">Personal</div>
        <div class="page-sub">Thabo Mokoena</div>
    </div>
    <div class="avatar">TM</div>
</div>

<!-- Balance Hero -->
<div class="balance-hero">
    <div class="balance-chip">Standard Bank · **** 4892</div>
    <div class="balance-amount">R8,450.00</div>
    <div class="balance-sub">Available balance</div>
    <div class="balance-stats">
        <div>
            <div class="b-stat-label">Income this month</div>
            <div class="b-stat-val" style="color:var(--green)">+ R12,300.00</div>
        </div>
        <div>
            <div class="b-stat-label">Expenses this month</div>
            <div class="b-stat-val" style="color:var(--red)">− R3,850.00</div>
        </div>
    </div>
</div>

<!-- Quick personal actions -->
<div class="quick-actions">
    <div class="qa-btn" onclick="showToast('Send Money — coming soon')">
        <div class="qa-btn-icon g">
            <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </div>
        <div class="qa-btn-title">Send Money</div>
        <div class="qa-btn-sub">EFT / instant pay</div>
    </div>

    <div class="qa-btn" onclick="showToast('Buy Airtime — coming soon')">
        <div class="qa-btn-icon b">
            <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
        </div>
        <div class="qa-btn-title">Buy Airtime</div>
        <div class="qa-btn-sub">Top up data</div>
    </div>

    <div class="qa-btn" onclick="showToast('Pay Bills — coming soon')">
        <div class="qa-btn-icon a">
            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <div class="qa-btn-title">Pay Bills</div>
        <div class="qa-btn-sub">Electricity, water</div>
    </div>

    <a asp-controller="Stokvel" asp-action="Index" class="qa-btn">
        <div class="qa-btn-icon" style="background:var(--amber-bg);color:var(--amber)">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="qa-btn-title">Stokvel</div>
        <div class="qa-btn-sub">Savings group</div>
    </a>
</div>

<!-- Recent Transactions -->
<div class="section-title">Recent Transactions</div>

<div class="txn-item">
    <div class="txn-icon" style="background:var(--green-bg); font-size:20px;">💰</div>
    <div class="txn-info">
        <div class="txn-name">Business Deposit</div>
        <div class="txn-time">Today, 18:32 · ATM Mimosa Mall</div>
    </div>
    <div class="txn-amount inc">+R780</div>
</div>

<div class="txn-item">
    <div class="txn-icon" style="background:var(--blue-bg); font-size:20px;">🛒</div>
    <div class="txn-info">
        <div class="txn-name">Makro Wholesale</div>
        <div class="txn-time">Yesterday, 10:14</div>
    </div>
    <div class="txn-amount exp">−R1,240</div>
</div>

<div class="txn-item">
    <div class="txn-icon" style="background:var(--amber-bg); font-size:20px;">🤝</div>
    <div class="txn-info">
        <div class="txn-name">Stokvel Contribution</div>
        <div class="txn-time">Mon 19 May · Thabo's Group</div>
    </div>
    <div class="txn-amount exp">−R500</div>
</div>

<div class="txn-item">
    <div class="txn-icon" style="background:var(--green-bg); font-size:20px;">💰</div>
    <div class="txn-info">
        <div class="txn-name">Business Deposit</div>
        <div class="txn-time">Fri 16 May · ATM Preller Sq</div>
    </div>
    <div class="txn-amount inc">+R650</div>
</div>

<!-- Stokvel CTA -->
<div class="section-title" style="margin-top:8px">Stokvel</div>
<a asp-controller="Stokvel" asp-action="Index" class="stokvel-hero">
    <div class="stokvel-title">Thabo's Savings Group</div>
    <div class="stokvel-sub">5 members · Active since Jan 2025</div>
    <div class="stokvel-amount">R14,500.00</div>
    <div class="stokvel-label">Total pot</div>
    <div style="display:flex; align-items:center; justify-content:space-between">
        <span class="pill amber">Your turn: June 2025</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 18l6-6-6-6"/>
        </svg>
    </div>
</a>

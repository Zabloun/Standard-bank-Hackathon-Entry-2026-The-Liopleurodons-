@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-5 fw-bold">Welcome to Liopleurodons</h1>
    <p class="lead text-muted">Your Pocket Business Helper</p>
    <hr class="my-4" />
    <div class="row g-4 justify-content-center mt-2">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">📦 Products</h5>
                    <p class="card-text text-muted">Manage your product catalogue and pricing.</p>
                    <a asp-controller="Business" asp-action="Index" class="btn btn-primary">Go to Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🗃️ Stock</h5>
                    <p class="card-text text-muted">Track your inventory and stock levels.</p>
                    <a asp-controller="Stock" asp-action="Index" class="btn btn-primary">Go to Stock</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🧾 Purchases</h5>
                    <p class="card-text text-muted">View and record your purchase history.</p>
                    <a asp-controller="Purchases" asp-action="Index" class="btn btn-primary">Go to Purchases</a>
                </div>
            </div>
        </div>
    </div>
</div>

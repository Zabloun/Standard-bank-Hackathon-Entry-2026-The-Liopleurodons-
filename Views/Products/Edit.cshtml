@model ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Edit Product</div>
        <div class="page-sub">Update details</div>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<form asp-controller="Products" asp-action="Edit" method="post" class="form-section">
    <input type="hidden" asp-for="ProductId" />

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="ProductName" class="form-label">Product Name</label>
        <input asp-for="ProductName" class="form-input" />
        <span asp-validation-for="ProductName" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="form-label">Description</label>
        <input asp-for="Description" class="form-input" />
        <span asp-validation-for="Description" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">— Select category —</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price" class="form-label">Selling Price (ZAR)</label>
        <div class="input-prefix-wrap">
            <span class="input-prefix">R</span>
            <input asp-for="Price" class="form-input" type="number" step="0.01" min="0.01" />
        </div>
        <span asp-validation-for="Price" class="form-error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <div style="margin-top:10px">
        <a asp-controller="Products" asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-danger">
            Delete Product
        </a>
    </div>
    <div style="margin-top:10px">
        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

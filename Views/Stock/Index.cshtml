@model StockOverviewViewModel
@{
    ViewData["Title"] = "Stock Levels";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Stock</div>
        <div class="page-sub">Inventory overview</div>
    </div>
    <a asp-controller="Business" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<!-- Summary Cards -->
<div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin:0 20px 20px">
    <div class="card" style="margin:0;padding:14px 16px;text-align:center">
        <div class="card-label" style="font-size:10px">Total Items</div>
        <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800">@Model.TotalProducts</div>
    </div>
    <div class="card" style="margin:0;padding:14px 16px;text-align:center">
        <div class="card-label" style="font-size:10px;color:var(--amber)">Low Stock</div>
        <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800;color:var(--amber)">@Model.LowStockCount</div>
    </div>
    <div class="card" style="margin:0;padding:14px 16px;text-align:center">
        <div class="card-label" style="font-size:10px;color:var(--red)">Out of Stock</div>
        <div style="font-family:'Syne',sans-serif;font-size:24px;font-weight:800;color:var(--red)">@Model.OutOfStockCount</div>
    </div>
</div>

<div class="section-title">All Products</div>

@if (!Model.StockLines.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">📦</div>
        <div class="empty-state-title">No stock items yet</div>
        Add products first, then set their stock levels.
    </div>
}
else
{
    <div class="card" style="padding:0">
        @foreach (var item in Model.StockLines)
        {
            <div class="list-item">
                <div class="list-item-icon">📦</div>
                <div class="list-item-body">
                    <div class="list-item-title">@item.ProductName</div>
                    <div class="list-item-sub">@item.CategoryName · R@item.UnitPrice.ToString("N2")</div>
                    <div class="stock-bar-wrap" style="width:80px">
                        <div class="stock-bar @item.StatusCss" style="width:@item.BarPercent%"></div>
                    </div>
                </div>
                <div style="text-align:right">
                    <span class="pill @item.StatusPill" style="font-size:10px">@item.StatusLabel</span>
                    <div style="font-size:12px;color:var(--txt3);margin-top:4px">R@item.StockValue.ToString("N2")</div>
                </div>
                <a asp-controller="Stock" asp-action="Edit" asp-route-id="@item.StockId" class="action-link edit" style="margin-left:6px">
                    Edit
                </a>
            </div>
        }
    </div>
}

<div style="margin:16px 20px 0">
    <a asp-controller="Products" asp-action="Create" class="btn btn-secondary">
        + Add New Product
    </a>
</div>

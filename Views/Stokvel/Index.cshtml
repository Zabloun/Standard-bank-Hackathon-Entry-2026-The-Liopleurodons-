@model Liopleurodons_Pocket_Business_Helper.Models.ViewModels.StokvelViewModel
@{
    ViewData["Title"] = "Stokvel";
    ViewData["ActiveNav"] = "stokvel";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <div class="page-title">Stokvel</div>
        <div class="page-sub">@Model.GroupName</div>
    </div>
    <a asp-controller="Business" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<!-- Total Pot Card -->
<div class="card" style="background:linear-gradient(135deg,#1A1000,#2A1A00); border-color:rgba(245,166,35,0.2)">
    <div class="card-label">Total Pot</div>
    <div class="card-value amber">R @Model.TotalPot.ToString("N2")</div>
    <div style="margin-top:12px; display:flex; gap:24px; flex-wrap:wrap;">
        <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.35);">This month's holder</div>
            <div style="font-size:13px;font-weight:500;margin-top:2px;color:var(--amber);">@Model.CurrentHolder</div>
        </div>
        <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.35);">Monthly contribution</div>
            <div style="font-size:13px;font-weight:500;margin-top:2px;">R @Model.MonthlyContribution.ToString("N0")</div>
        </div>
        <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.35);">Cycle start</div>
            <div style="font-size:13px;font-weight:500;margin-top:2px;">@Model.CycleStart</div>
        </div>
    </div>
</div>

<!-- Countdown Box -->
<div style="margin: 0 20px 16px;">
    <div class="countdown-box">
        <div>
            <div class="countdown-label">Your turn</div>
            <div class="countdown-val">@Model.YourTurnMonth</div>
        </div>
        <div style="text-align:center;">
            <div class="countdown-label">Days remaining</div>
            <div class="countdown-val" id="daysLeft">—</div>
        </div>
        <div style="text-align:right;">
            <div class="countdown-label">Your position</div>
            <div class="countdown-val"># @Model.YourPosition of @Model.TotalMembers</div>
        </div>
    </div>
</div>

<!-- Members & Rotation -->
<div class="section-title">Members &amp; Rotation</div>
<div class="card" style="padding:16px 20px;">
    @foreach (var member in Model.Members)
    {
        <div class="member-row">
            <div class="member-avatar" style="background:@member.AvatarColor">@member.Initials</div>
            <div class="member-name">@member.Name</div>
            <div class="member-month">@member.Month</div>
            @if (member.IsCurrent)
            {
                <span class="member-badge current">Current</span>
            }
            else if (member.IsYou)
            {
                <span class="member-badge you">You · Next</span>
            }
            else
            {
                <span style="font-size:11px;color:var(--txt3);">#@member.Position</span>
            }
        </div>
    }
</div>

<!-- Contributions -->
<div class="section-title">This Month's Contributions</div>
<div class="card" style="padding:16px 20px;">
    @foreach (var c in Model.RecentContributions)
    {
        <div class="contrib-row">
            <div class="member-avatar" style="background:@c.AvatarColor; width:32px; height:32px; font-size:11px;">@c.Initials</div>
            <div style="flex:1;">
                <div style="font-size:13px; font-weight:500;">@c.MemberName</div>
                <div style="font-size:11px; color:var(--txt3);">@c.DateLabel</div>
            </div>
            @if (c.Paid)
            {
                <div class="contrib-amount paid">+R @c.Amount.ToString("N0")</div>
                <span class="pill green" style="margin-left:6px; font-size:10px;">Paid</span>
            }
            else
            {
                <div class="contrib-amount pending">R @c.Amount.ToString("N0")</div>
                <span class="pill amber" style="margin-left:6px; font-size:10px;">Pending</span>
            }
        </div>
    }
</div>

<!-- Actions -->
<div style="padding: 4px 20px 0;">
    <button class="btn btn-primary" onclick="openSheet('contributeSheet')" style="margin-bottom:12px;">
        💰 Contribute to Pot
    </button>
    <button class="btn btn-secondary" onclick="openSheet('inviteSheet')">
        + Invite Member
    </button>
</div>

<!-- ===== CONTRIBUTE SHEET ===== -->
<div class="sheet-overlay" id="contributeSheet">
    <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">Contribute to Pot</div>

        <form asp-action="Contribute" method="post">
            @Html.AntiForgeryToken()
            <div style="background:var(--amber-bg); border:0.5px solid rgba(245,166,35,0.3); border-radius:12px; padding:12px 14px; margin-bottom:20px; display:flex; justify-content:space-between;">
                <div>
                    <div style="font-size:11px; color:rgba(255,255,255,0.4);">Current pot</div>
                    <div style="font-family:'Syne',sans-serif; font-size:18px; font-weight:700; color:var(--amber);">R @Model.TotalPot.ToString("N2")</div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:11px; color:rgba(255,255,255,0.4);">Monthly target</div>
                    <div style="font-size:15px; font-weight:600; color:var(--txt);">R @Model.MonthlyContribution.ToString("N0")</div>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Amount (R)</label>
                <input name="Amount" type="number" step="50" min="1" class="form-input" placeholder="500" value="@Model.MonthlyContribution.ToString("0")" />
            </div>

            <!-- Quick amounts -->
            <div style="display:flex; gap:8px; margin-bottom:20px;">
                @foreach (var amt in new[] { 100, 250, 500, 1000 })
                {
                    <button type="button" class="btn btn-secondary" style="flex:1; padding:8px; font-size:12px; border-radius:10px;" onclick="document.querySelector('[name=Amount]').value='@amt'">R @amt</button>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Note (optional)</label>
                <input name="Note" class="form-input" placeholder="May contribution..." />
            </div>

            <button type="submit" class="btn btn-primary">Confirm Contribution</button>
            <button type="button" class="btn btn-secondary" onclick="closeSheet('contributeSheet')" style="margin-top:10px;">Cancel</button>
        </form>
    </div>
</div>

<!-- ===== INVITE SHEET ===== -->
<div class="sheet-overlay" id="inviteSheet">
    <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-title">Invite a Member</div>

        <form asp-action="InviteMember" method="post">
            @Html.AntiForgeryToken()

            <div style="background:var(--blue-bg); border:0.5px solid rgba(26,92,255,0.3); border-radius:12px; padding:12px 14px; margin-bottom:20px; font-size:13px; color:var(--txt2);">
                An invitation link will be sent to their email address. Once they accept, they'll be added to the rotation.
            </div>

            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input name="Name" class="form-input" placeholder="e.g. Zanele Dube" />
            </div>
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input name="Email" type="email" class="form-input" placeholder="zanele@example.com" />
            </div>

            <button type="submit" class="btn btn-primary">Send Invitation</button>
            <button type="button" class="btn btn-secondary" onclick="closeSheet('inviteSheet')" style="margin-top:10px;">Cancel</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        // Countdown to your turn month
        const yourTurn = new Date(2025, 5, 1); // June 2025
        const now = new Date();
        const diff = Math.ceil((yourTurn - now) / (1000 * 60 * 60 * 24));
        const el = document.getElementById('daysLeft');
        if (el) el.textContent = diff > 0 ? diff + 'd' : 'Now!';
    })();
</script>
}

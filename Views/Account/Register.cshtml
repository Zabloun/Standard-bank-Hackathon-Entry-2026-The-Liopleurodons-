@model Liopleurodons_Pocket_Business_Helper.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div style="padding: 40px 24px 24px;">
    <!-- Back + heading -->
    <div class="page-header" style="padding: 0 0 24px;">
        <div>
            <div class="page-title">Create Account</div>
            <div class="page-sub">Set up your Skhokho profile</div>
        </div>
        <a asp-action="Login" class="btn-icon">
            <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="validation-summary">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label class="form-label">Business Name</label>
            <input asp-for="BusinessName" class="form-input" placeholder="e.g. Thabo's Spaza" />
            <span asp-validation-for="BusinessName" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Email address</label>
            <input asp-for="Email" class="form-input" type="email" placeholder="you@example.com" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="form-group">
            <label class="form-label">Password <span style="color:var(--txt3)">(min. 6 characters)</span></label>
            <input asp-for="Password" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="form-group" style="margin-bottom:28px;">
            <label class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-input" type="password" placeholder="••••••••" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-bottom:14px;">Create Account</button>
    </form>

    <div style="text-align:center; font-size:13px; color:var(--txt3);">
        Already have an account?
        <a asp-action="Login" style="color:var(--green); text-decoration:none; font-weight:500;"> Sign in →</a>
    </div>
</div>

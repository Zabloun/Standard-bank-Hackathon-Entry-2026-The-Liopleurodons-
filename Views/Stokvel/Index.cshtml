@{
    ViewData["Title"] = "Stokvel";
    ViewData["ActiveNav"] = "stokvel";
}

<div class="page-header">
    <div>
        <div class="page-title">Stokvel</div>
        <div class="page-sub">Thabo's Savings Group</div>
    </div>
    <a asp-controller="Personal" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<!-- Total Pot Card -->
<div class="card" style="background:linear-gradient(135deg,#1A1000,#2A1A00); border-color:rgba(245,166,35,0.2)">
    <div class="card-label">Total Pot</div>
    <div class="card-value amber">R14,500.00</div>
    <div style="margin-top:12px; display:flex; gap:20px">
        <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.35)">This month's holder</div>
            <div style="font-size:13px;font-weight:500;margin-top:2px;color:var(--amber)">Thabo Mokoena</div>
        </div>
        <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.35)">Cycle start</div>
            <div style="font-size:13px;font-weight:500;margin-top:2px">Jan 2025</div>
        </div>
    </div>
</div>

<!-- Countdown Box -->
<div style="margin:0 20px 16px">
    <div class="countdown-box">
        <div>
            <div class="countdown-label">Your turn</div>
            <div class="countdown-val">June 2025</div>
        </div>
        <div style="text-align:right">
            <div class="countdown-label">Days remaining</div>
            <div class="countdown-val" id="days-left">—</div>
        </div>
        <div style="text-align:right">
            <div class="countdown-label">Your position</div>
            <div class="countdown-val">#2 of 5</div>
        </div>
    </div>
</div>

<!-- Members & Rotation -->
<div class="section-title">Members &amp; Rotation</div>
<div class="card" style="padding:16px 20px">
    <div class="member-list">

        <div class="member-row">
            <div class="member-avatar" style="background:#00A264">SK</div>
            <div class="member-name">Sipho Khumalo</div>
            <div class="member-month">May 2025</div>
            <span class="member-active">Current</span>
        </div>

        <div class="member-row">
            <div class="member-avatar" style="background:#1248D4">TM</div>
            <div class="member-name">Thabo Mokoena</div>
            <div class="member-month">June 2025</div>
            <span class="pill amber" style="font-size:10px;padding:3px 8px">You · Next</span>
        </div>

        <div class="member-row">
            <div class="member-avatar" style="background:#7B3F00">LN</div>
            <div class="member-name">Lerato Nkosi</div>
            <div class="member-month">July 2025</div>
            <span style="font-size:11px;color:var(--txt3)">#3</span>
        </div>

        <div class="member-row">
            <div class="member-avatar" style="background:#5C0F8B">PM</div>
            <div class="member-name">Palesa Molefe</div>
            <div class="member-month">August 2025</div>
            <span style="font-size:11px;color:var(--txt3)">#4</span>
        </div>

        <div class="member-row">
            <div class="member-avatar" style="background:#8B2500">ND</div>
            <div class="member-name">Nkosi Dlamini</div>
            <div class="member-month">September 2025</div>
            <span style="font-size:11px;color:var(--txt3)">#5</span>
        </div>

    </div>
</div>

<!-- Actions -->
<div style="margin:4px 20px 0">
    <button class="btn btn-primary" onclick="showToast('✓ R500 contributed to pot!')">
        Contribute to Pot
    </button>
</div>
<div style="margin:10px 20px 0">
    <button class="btn btn-secondary" onclick="showToast('Invite link copied!')">
        + Invite Member
    </button>
</div>

@section Scripts {
<script>
    (function () {
        const now = new Date();
        const target = new Date(2025, 5, 1); // June 1
        const diff = Math.ceil((target - now) / (1000 * 60 * 60 * 24));
        const el = document.getElementById('days-left');
        if (el) el.textContent = diff > 0 ? diff + 'd' : 'Now!';
    })();
</script>
}

@model CategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Edit Category</div>
        <div class="page-sub">Update details</div>
    </div>
    <a asp-controller="Categories" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<form asp-controller="Categories" asp-action="Edit" method="post" class="form-section">
    <input type="hidden" asp-for="CategoryId" />

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="CategoryName" class="form-label">Category Name</label>
        <input asp-for="CategoryName" class="form-input" />
        <span asp-validation-for="CategoryName" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryDescription" class="form-label">Description</label>
        <input asp-for="CategoryDescription" class="form-input" />
        <span asp-validation-for="CategoryDescription" class="form-error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <div style="margin-top:10px">
        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@Model.CategoryId" class="btn btn-danger">
            Delete Category
        </a>
    </div>
    <div style="margin-top:10px">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ProductListViewModel
@{
    ViewData["Title"] = "Delete Product";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Delete</div>
        <div class="page-sub">Confirm removal</div>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<div style="padding:0 20px">
    <div class="confirm-card">
        <div class="confirm-icon">🗑️</div>
        <div class="confirm-title">Remove "@Model.ProductName"?</div>
        <div class="confirm-sub">
            This will permanently remove the product and its associated stock record.
            This action cannot be undone.
        </div>
        <div style="margin-bottom:16px">
            <span class="pill blue">@Model.CategoryName</span>
            <span class="pill green" style="margin-left:6px">R@Model.Price.ToString("N2")</span>
        </div>
        <div class="confirm-actions">
            <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
            <form asp-controller="Products" asp-action="DeleteConfirmed" method="post" style="flex:1">
                <input type="hidden" name="id" value="@Model.ProductId" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
            </form>
        </div>
    </div>
</div>

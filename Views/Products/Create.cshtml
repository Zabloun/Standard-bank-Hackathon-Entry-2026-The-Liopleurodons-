@model ProductViewModel
@{
    ViewData["Title"] = "Add Product";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">New Product</div>
        <div class="page-sub">Add to your catalogue</div>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

<form asp-controller="Products" asp-action="Create" method="post" class="form-section">
    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="ProductName" class="form-label">Product Name</label>
        <input asp-for="ProductName" class="form-input" placeholder="e.g. 2L Coca-Cola" />
        <span asp-validation-for="ProductName" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="form-label">Description</label>
        <input asp-for="Description" class="form-input" placeholder="Brief description…" />
        <span asp-validation-for="Description" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">— Select category —</option>
            @foreach (var cat in Model.Categories)
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="form-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price" class="form-label">Selling Price (ZAR)</label>
        <div class="input-prefix-wrap">
            <span class="input-prefix">R</span>
            <input asp-for="Price" class="form-input" type="number" step="0.01" min="0.01" placeholder="0.00" />
        </div>
        <span asp-validation-for="Price" class="form-error"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Product</button>
    <div style="margin-top:10px">
        <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

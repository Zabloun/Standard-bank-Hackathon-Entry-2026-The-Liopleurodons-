@model BusinessDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActiveNav"] = "business";
}

<!-- Header -->
<div class="page-header">
    <div>
        <div class="page-title"> @Model.BusinessName</div>
        <div class="page-sub"> @Model.DayLabel · Live dashboard</div>
    </div>
    <div class="avatar"> @Model.OwnerInitials</div>
</div>

<!-- Revenue Hero Card -->
<div class="hero-card">
    <div class="hero-card-label">TODAY'S REVENUE</div>
    <div class="hero-card-amount">R @Model.TodayRevenue.ToString("N2")</div>
    <span class="pill @(Model.TodayProfit >= 0 ? "green" : "red")">
        @(Model.TodayProfit >= 0 ? "+" : "")R @Model.TodayProfit.ToString("N2") profit
    </span>
    <div class="hero-card-row">
        <div class="hero-card-stat">
            <div class="hero-card-stat-label">Expenses</div>
            <div class="hero-card-stat-val">R @Model.TodayExpenses.ToString("N2")</div>
        </div>
        <div class="hero-card-stat">
            <div class="hero-card-stat-label">Transactions</div>
            <div class="hero-card-stat-val"> @Model.TodayTransactionCount</div>
        </div>
        <div class="hero-card-stat">
            <div class="hero-card-stat-label">Margin</div>
            <div class="hero-card-stat-val"> @(Model.TodayRevenue > 0 ? ((Model.TodayProfit / Model.TodayRevenue) * 100).ToString("0") + "%" : "—")</div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="quick-actions">
    <a asp-controller="Purchases" asp-action="RestockCreate" class="qa-btn">
        <div class="qa-btn-icon g">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </div>
        <div class="qa-btn-title">Record Sale</div>
        <div class="qa-btn-sub">Log new income</div>
    </a>
    <a asp-controller="Purchases" asp-action="Create" class="qa-btn">
        <div class="qa-btn-icon r">
            <svg viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
        </div>
        <div class="qa-btn-title">Log Expense</div>
        <div class="qa-btn-sub">Record a spend</div>
    </a>
    <a asp-controller="Stock" asp-action="Index" class="qa-btn">
        <div class="qa-btn-icon a">
            <svg viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
        </div>
        <div class="qa-btn-title">Stock Levels</div>
        <div class="qa-btn-sub">View inventory</div>
    </a>
    <a asp-controller="Stokvel" asp-action="Index" class="qa-btn">
        <div class="qa-btn-icon b">
            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <div class="qa-btn-title">Stokvel</div>
        <div class="qa-btn-sub">R @((Model.TodayRevenue + 12000).ToString("N0")) pot</div>
    </a>
</div>

@if (Model.ShowDepositBanner)
{
    <form id="deposit-form" asp-controller="ATM" asp-action="Index" method="post" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <div class="eod-banner" onclick="document.getElementById('deposit-form').submit()" style="cursor:pointer;">
        <div class="eod-icon">🏦</div>
        <div>
            <div class="eod-title">Ready to deposit?</div>
            <div class="eod-sub">R @Model.TodayRevenue.ToString("N2") cash on hand — tap to record deposit</div>
        </div>
        <div style="margin-left:auto; font-size:11px; color:var(--green); font-weight:600;">TAP →</div>
    </div>
}

<!-- Recent Transactions -->
<div class="section-title">Recent Transactions</div>
@foreach (var txn in Model.RecentTransactions)
{
    <div class="txn-item">
        <div class="txn-icon" style="background:@txn.IconBackground">@txn.Emoji</div>
        <div class="txn-info">
            <div class="txn-name">@txn.Description</div>
            <div class="txn-time">@txn.TypeLabel · @txn.TimeLabel</div>
        </div>
        <div class="txn-amount @txn.AmountCssClass">@txn.AmountDisplay</div>
    </div>
}
<div style="height:8px;"></div>

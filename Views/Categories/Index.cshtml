@model CategoryListViewModel
@{
    ViewData["Title"] = "Categories";
    ViewData["ActiveNav"] = "business";
}

<div class="page-header">
    <div>
        <div class="page-title">Categories</div>
        <div class="page-sub"> @Model.Categories.Count group @(Model.Categories.Count == 1 ? "" : "s")</div>
    </div>
    <a asp-controller="Products" asp-action="Index" class="btn-icon">
        <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
    </a>
</div>

@if (!Model.Categories.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">🏷️</div>
        <div class="empty-state-title">No categories yet</div>
        Create a category to start organising your products.
    </div>
}
else
{
    <div class="card" style="padding:0">
        @foreach (var cat in Model.Categories)
        {
            <div class="list-item">
                <div class="list-item-icon">🏷️</div>
                <div class="list-item-body">
                    <div class="list-item-title">@cat.CategoryName</div>
                    <div class="list-item-sub">@cat.CategoryDescription</div>
                </div>
                <span class="pill blue" style="font-size:11px">@cat.ProductCount product@(cat.ProductCount == 1 ? "" : "s")</span>
                <div class="list-item-actions">
                    <a asp-controller="Categories" asp-action="Edit" asp-route-id="@cat.CategoryId" class="action-link edit">Edit</a>
                    <a asp-controller="Categories" asp-action="Delete" asp-route-id="@cat.CategoryId" class="action-link delete">Del</a>
                </div>
            </div>
        }
    </div>
}

<div style="margin:16px 20px 0">
    <a asp-controller="Categories" asp-action="Create" class="btn btn-primary">+ New Category</a>
</div>
